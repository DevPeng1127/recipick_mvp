# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recipick

# JWT
# Required in every environment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a separate key for production; never reuse the local development key.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback

# Gemini AI
# For free local development, use a key from a Free Tier project in AI Studio.
# The model name alone does not determine billing; see README for setup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173
